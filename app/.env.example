# Runtime state directory (must be writable by the service user)
BACKGROUND_BOARD_DATA_DIR=/srv/background-board/data

# Keep the new guided workflow disabled until its real-model evaluation passes.
BACKGROUND_BOARD_GUIDANCE_V2=0

# Preferred generic OpenAI-compatible agent configuration
AGENT_API_URL=
AGENT_API_KEY=
AGENT_MODEL=

# Model transport. legacy (default) keeps the original resolution order:
# AGENT_API_URL -> OpenCode -> Zhihu zhida fallback. sdk uses the OpenAI Node SDK
# to call AGENT_SDK_BASE_URL directly and never falls back to zhida or OpenCode.
AGENT_TRANSPORT=legacy
# Required when AGENT_TRANSPORT=sdk. Base URL form: https://provider.example/v1
# (no /chat/completions suffix; AGENT_API_URL keeps its full-URL semantics).
AGENT_SDK_BASE_URL=
# Reused as the SDK bearer key when AGENT_TRANSPORT=sdk.
# AGENT_API_KEY=
AGENT_MODEL=
# 0 (default) disables streaming; 1 sends stream:true and assembles the answer
# server-side before protocol validation.
AGENT_SDK_STREAM=0

# Guidance policy: legacy (default) keeps the original budgets and lenient
# override semantics; fast uses the shorter budgets below and rejects invalid
# numeric overrides with a clear configuration error instead of slowing down.
GUIDANCE_POLICY=legacy
# --- legacy policy defaults (production values) ---
# Single model call timeout in milliseconds (default: 90000 = 90s)
GUIDANCE_MODEL_TIMEOUT_MS=90000
# Total wall-clock budget for one guidance run in milliseconds (default: 240000 = 4min)
GUIDANCE_RUN_BUDGET_MS=240000
# Max transport retries per reasoning step (default: 2)
GUIDANCE_MODEL_MAX_RETRIES=2
# --- fast policy defaults (only used when GUIDANCE_POLICY=fast) ---
# run budget 60000 (60s), model timeout 40000 (40s), max retries 1,
# search timeout 8000 (8s), max searches 1, max model steps 3.
# Explicit overrides of the values above must be positive integers; invalid
# values are a hard configuration error under fast policy or sdk transport.
# Per-search deadline shared by both policies (default: 8000 = 8s)
GUIDANCE_SEARCH_TIMEOUT_MS=8000
# Logical search actions per run (legacy default: 2, fast default: 1)
GUIDANCE_MAX_SEARCHES=2
# Logical model steps per run (legacy default: 5, fast default: 3)
GUIDANCE_MAX_MODEL_STEPS=5
# Guidance run-start rate limit per 10 minutes (both sync and async endpoints)
GUIDANCE_RUN_RATE_LIMIT=10

# Optional existing OpenCode server (preferred over the Zhihu answer-model fallback)
OPENCODE_SERVER_URL=
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=

# Enables Zhihu search. When AGENT_* is empty, this also powers zhida-agent.
ZHIHU_ACCESS_SECRET=

APP_VERSION=0.1.0
